# Makefile.libretro — build mednafen_stv_libretro.{so,dll,dylib}
# Usage:
#   Linux:          make -f libretro/Makefile.libretro [TARGET_CROSS=aarch64-buildroot-linux-gnu-]
#   macOS:          make -f libretro/Makefile.libretro platform=osx
#   Windows:        make -f libretro/Makefile.libretro platform=win64 TARGET_CROSS=x86_64-w64-mingw32-
#   Android arm64:  make -f libretro/Makefile.libretro platform=android-arm64  ANDROID_NDK_ROOT=/path/to/ndk
#   Android armv7:  make -f libretro/Makefile.libretro platform=android-armv7  ANDROID_NDK_ROOT=/path/to/ndk
#   Android x86_64: make -f libretro/Makefile.libretro platform=android-x86_64 ANDROID_NDK_ROOT=/path/to/ndk
#   Android x86:    make -f libretro/Makefile.libretro platform=android-x86    ANDROID_NDK_ROOT=/path/to/ndk
#
# CC/CXX/AR set in the environment or on the command line take precedence over
# the platform defaults below — that is how the libretro buildbot templates
# hand a core its cross toolchain.

TARGET_NAME := mednafen_stv
CORE_DIR    := $(CURDIR)

platform ?= unix

# Spellings used by the buildbot templates.
ifeq ($(platform),android-arm)
   override platform := android-armv7
endif
ifneq (,$(filter $(platform),win windows))
   override platform := win64
endif

BUILD_DIR   := $(CORE_DIR)/build_libretro/$(platform)

# zstd is only ever used for decompression here (ZstdDecompressFilter), which
# the copy bundled in mednafen/zstd covers, so the core has no external zstd
# dependency by default. USE_SYSTEM_ZSTD=1 links against -lzstd instead.
USE_SYSTEM_ZSTD  ?= 0
USE_BUNDLED_ZSTD := 1
ifeq ($(USE_SYSTEM_ZSTD),1)
   USE_BUNDLED_ZSTD :=
   ZSTD_LIBS := -lzstd
endif

TARGET_EXT  := so
TARGET_FILE := $(TARGET_NAME)_libretro
WIN32_BUILD :=
fpic        := -fPIC

ifeq ($(platform),unix)
   CC_DEF  := $(TARGET_CROSS)gcc
   CXX_DEF := $(TARGET_CROSS)g++
   AR_DEF  := $(TARGET_CROSS)ar
   PLATFORM_LIBS := -lz -lpthread $(ZSTD_LIBS)
   SHARED := -shared -Wl,-soname,$(TARGET_FILE).so \
             -Wl,--version-script=$(CORE_DIR)/libretro/link.T
else ifeq ($(platform),osx)
   TARGET_EXT := dylib
   CC_DEF  := clang
   CXX_DEF := clang++
   AR_DEF  := ar
   PLATFORM_LIBS := -lz -lpthread -liconv $(ZSTD_LIBS)
   SHARED := -dynamiclib
   ifneq ($(LIBRETRO_APPLE_PLATFORM),)
      APPLE_FLAGS := -target $(LIBRETRO_APPLE_PLATFORM)
   endif
   ifneq ($(LIBRETRO_APPLE_ISYSROOT),)
      APPLE_FLAGS += -isysroot $(LIBRETRO_APPLE_ISYSROOT)
   endif
else ifneq (,$(filter $(platform),win64 win32))
   TARGET_EXT  := dll
   WIN32_BUILD := 1
   CC_DEF  := $(TARGET_CROSS)gcc
   CXX_DEF := $(TARGET_CROSS)g++
   AR_DEF  := $(TARGET_CROSS)ar
   # -fPIC is the default on Windows and only earns a warning if passed.
   fpic :=
   PLATFORM_LIBS := -lz -lws2_32 $(ZSTD_LIBS)
   SHARED := -shared -static-libgcc -static-libstdc++
else ifneq (,$(filter $(platform),android-arm64 android-armv7 android-x86_64 android-x86))
   ANDROID_NDK_ROOT ?= $(NDK_ROOT)
   ifeq ($(ANDROID_NDK_ROOT),)
      $(error Set ANDROID_NDK_ROOT (or NDK_ROOT) to your Android NDK path)
   endif
   ANDROID_API ?= 24
   HOST_TAG := $(shell uname -s | tr A-Z a-z)-x86_64
   NDK_BIN  := $(ANDROID_NDK_ROOT)/toolchains/llvm/prebuilt/$(HOST_TAG)/bin

   ifeq ($(platform),android-arm64)
      ANDROID_TRIPLE := aarch64-linux-android
   endif
   ifeq ($(platform),android-armv7)
      ANDROID_TRIPLE := armv7a-linux-androideabi
   endif
   ifeq ($(platform),android-x86_64)
      ANDROID_TRIPLE := x86_64-linux-android
   endif
   ifeq ($(platform),android-x86)
      ANDROID_TRIPLE := i686-linux-android
   endif

   # The NDK toolchain is not negotiable here, so it is not left to CC/CXX.
   CC  := $(NDK_BIN)/$(ANDROID_TRIPLE)$(ANDROID_API)-clang
   CXX := $(NDK_BIN)/$(ANDROID_TRIPLE)$(ANDROID_API)-clang++
   AR  := $(NDK_BIN)/llvm-ar

   TARGET_FILE   := $(TARGET_NAME)_libretro_android
   PLATFORM_LIBS := -lz -llog $(ZSTD_LIBS)
   # bionic has no iconv; mednafen's config header already keys off __ANDROID__
   USE_BUNDLED_ZSTD := 1
   SHARED := -shared -Wl,-soname,$(TARGET_FILE).so \
             -Wl,--version-script=$(CORE_DIR)/libretro/link.T \
             -static-libstdc++
else
   $(error Unknown platform "$(platform)")
endif

# Platform defaults only apply when make is using its own built-ins, so a
# toolchain named in the environment or on the command line survives.
ifeq ($(origin CC),default)
   CC := $(CC_DEF)
endif
ifeq ($(origin CXX),default)
   CXX := $(CXX_DEF)
endif
ifeq ($(origin AR),default)
   AR := $(AR_DEF)
endif

CCACHE_BIN ?=
ifneq ($(CCACHE_BIN),)
   CC  := $(CCACHE_BIN) $(CC)
   CXX := $(CCACHE_BIN) $(CXX)
endif

$(shell mkdir -p $(BUILD_DIR))
$(shell cp $(CORE_DIR)/libretro/config_libretro.h $(BUILD_DIR)/config.h)

CORE_VERSION ?= 1.2.1

DEFINES := \
    -DHAVE_CONFIG_H \
    -DLIBRETRO_BUILD=1 \
    -DLIBRETRO_CORE_VERSION=\"$(CORE_VERSION)\" \
    -D__LIBRETRO__=1 \
    -DWANT_SS_EMU=1 \
    -DMDFN_DISABLE_PICPIE_ERRWARN=1 \
    -D_LARGEFILE_SOURCE \
    -D_LARGEFILE64_SOURCE \
    -D_FILE_OFFSET_BITS=64

INCLUDES := \
    -I$(CORE_DIR)/libretro/wrapper_include \
    -I$(BUILD_DIR) \
    -I$(CORE_DIR) \
    -I$(CORE_DIR)/mednafen \
    -I$(CORE_DIR)/mednafen/minilzo

ifeq ($(USE_BUNDLED_ZSTD),1)
   INCLUDES += -I$(CORE_DIR)/mednafen/zstd
endif

CXXFLAGS := \
    -std=gnu++11 -O3 \
    -fsigned-char -fwrapv -fexceptions \
    -fno-fast-math -fno-unsafe-math-optimizations \
    -fstrict-aliasing \
    $(fpic) -fvisibility=hidden \
    $(APPLE_FLAGS) \
    $(DEFINES) $(INCLUDES) \
    -include $(BUILD_DIR)/config.h

# GCC-only flags; clang (NDK, Apple) doesn't know them.
ifeq (0,$(shell $(CXX) --version 2>/dev/null | grep -c clang))
   CXXFLAGS += -fno-printf-return-value -fno-aggressive-loop-optimizations -fno-ipa-icf
endif

CFLAGS := \
    -O3 -fsigned-char -fwrapv \
    -fno-fast-math -fno-unsafe-math-optimizations \
    -fstrict-aliasing $(fpic) -fvisibility=hidden \
    $(APPLE_FLAGS) \
    -DHAVE_CONFIG_H -DZSTD_NO_TRACE=1 -DZSTD_HAVE_WEAK_SYMBOLS=0 \
    $(INCLUDES) \
    -include $(BUILD_DIR)/config.h

LDFLAGS := $(SHARED) $(APPLE_FLAGS) $(PLATFORM_LIBS)

CORE_SRCS :=
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/ss/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/ss/input/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/ss/cart/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/cdrom/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/video/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/sound/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/compress/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/string/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hash/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/time/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/resampler/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_cpu/v810/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_cpu/m68k/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_cpu/z80-fuse/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_misc/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_sound/*.cpp)
CORE_SRCS += $(wildcard $(CORE_DIR)/mednafen/hw_video/*.cpp)

# Standalone driver sources
CORE_SRCS := $(filter-out $(CORE_DIR)/mednafen/drivers/%, $(CORE_SRCS))
# Test-only sources (qtrecord.cpp is kept: referenced by mednafen.cpp, zlib already linked)
CORE_SRCS := $(filter-out \
    $(CORE_DIR)/mednafen/tests.cpp \
    $(CORE_DIR)/mednafen/testsexp.cpp \
    $(CORE_DIR)/mednafen/sound/okiadpcm_generate.cpp, $(CORE_SRCS))
# CD audio decoders needing optional libs (mpc/vorbis/flac) — use stubs instead
CORE_SRCS := $(filter-out \
    $(CORE_DIR)/mednafen/cdrom/CDAFReader_MPC.cpp \
    $(CORE_DIR)/mednafen/cdrom/CDAFReader_Vorbis.cpp \
    $(CORE_DIR)/mednafen/cdrom/CDAFReader_FLAC.cpp, $(CORE_SRCS))

# Threading, networking and time backends, plus the sources the globs above
# do not reach.
CORE_SRCS += $(CORE_DIR)/mednafen/net/Net.cpp
ifeq ($(WIN32_BUILD),1)
   CORE_SRCS += \
       $(CORE_DIR)/mednafen/net/Net_WS2.cpp \
       $(CORE_DIR)/mednafen/mthreading/MThreading_Win32.cpp
else
   # Windows-only sources
   CORE_SRCS := $(filter-out %win32-common.cpp %_Win32.cpp %_win32.cpp, $(CORE_SRCS))
   CORE_SRCS += \
       $(CORE_DIR)/mednafen/net/Net_POSIX.cpp \
       $(CORE_DIR)/mednafen/mthreading/MThreading_POSIX.cpp
endif

LIBRETRO_SRCS := $(CORE_DIR)/libretro/libretro.cpp
ALL_CXX_SRCS  := $(LIBRETRO_SRCS) $(CORE_SRCS)

# C sources (not picked up by *.cpp globs)
CORE_C_SRCS := \
    $(CORE_DIR)/mednafen/minilzo/minilzo.c \
    $(CORE_DIR)/mednafen/quicklz/quicklz.c \
    $(CORE_DIR)/mednafen/cputest/cputest.c \
    $(CORE_DIR)/mednafen/resampler/resample.c \
    $(CORE_DIR)/mednafen/trio/trio.c \
    $(CORE_DIR)/mednafen/trio/trionan.c \
    $(CORE_DIR)/mednafen/trio/triostr.c

ifeq ($(USE_BUNDLED_ZSTD),1)
   CORE_C_SRCS += \
       $(CORE_DIR)/mednafen/zstd/common/entropy_common.c \
       $(CORE_DIR)/mednafen/zstd/common/error_private.c \
       $(CORE_DIR)/mednafen/zstd/common/fse_decompress.c \
       $(CORE_DIR)/mednafen/zstd/common/xxhash.c \
       $(CORE_DIR)/mednafen/zstd/common/zstd_common.c \
       $(CORE_DIR)/mednafen/zstd/decompress/huf_decompress.c \
       $(CORE_DIR)/mednafen/zstd/decompress/zstd_ddict.c \
       $(CORE_DIR)/mednafen/zstd/decompress/zstd_decompress_block.c \
       $(CORE_DIR)/mednafen/zstd/decompress/zstd_decompress.c
endif

OBJS := $(patsubst $(CORE_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(ALL_CXX_SRCS)) \
        $(patsubst $(CORE_DIR)/%.c,$(BUILD_DIR)/%.o,$(CORE_C_SRCS))

TARGET := $(CORE_DIR)/$(TARGET_FILE).$(TARGET_EXT)

.PHONY: all clean

all: $(TARGET)
	@echo "Built: $@"

$(TARGET): $(OBJS)
	$(CXX) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/%.o: $(CORE_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(BUILD_DIR)/%.o: $(CORE_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD_DIR) $(TARGET)
